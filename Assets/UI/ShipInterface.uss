.hud-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background-color: rgba(0, 0, 0, 0.4);
}

.hud-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.hud-label--left {
    text-align: left;
}

.hud-label--right {
    text-align: right;
}

.labelContainer {
    flex-direction: row;
}
