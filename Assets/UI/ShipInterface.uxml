        </ui:VisualElement>
        <ui:VisualElement name="LabelContriner" class="labelContainer">
            <ui:Label text="Sail Rotation" class="hud-label hud-label--right"/>
            <ui:Label name="rot-label-val" text="" class="hud-label hud-label--right">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="sailRot" data-source="project://database/Assets/Resources/Ship1.asset?fileID=11400000&amp;guid=e327b6a411d38374ab8c50f4b215dd6d&amp;type=2#Ship1" binding-mode="ToTarget"/>
                </Bindings>
